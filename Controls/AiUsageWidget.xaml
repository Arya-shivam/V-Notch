<UserControl x:Class="VNotch.Controls.AiUsageWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="108" Foreground="White"
             AutomationProperties.Name="AI subscription usage">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProviderPicker" FontSize="12" Margin="0,0,3,3"
                      DisplayMemberPath="DisplayName" SelectedValuePath="ProviderId"
                      SelectionChanged="ProviderPicker_SelectionChanged"
                      AutomationProperties.Name="Usage provider"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="↻" Margin="0,0,0,3"
                    Click="Refresh_Click" ToolTip="Refresh usage"
                    AutomationProperties.Name="Refresh usage"/>
        </Grid>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="WindowScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ItemsControl x:Name="WindowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,5" ToolTip="{Binding ResetText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#BBBBBB"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="11"
                                               FontWeight="SemiBold" Margin="4,0,0,0"/>
                                </Grid>
                                <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" Maximum="100" Height="4"
                                             Margin="0,3,0,0" Foreground="#FFFFFF" Background="#333333"
                                             BorderThickness="0" AutomationProperties.Name="Remaining allowance"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" Text="Select AI usage in Settings to connect."
                       FontSize="11" Foreground="#BBBBBB" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="UpdatedText" Grid.Row="2" FontSize="11" Foreground="#BBBBBB"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
